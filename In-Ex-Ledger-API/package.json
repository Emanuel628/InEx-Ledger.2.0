{
  "name": "inex-ledger-api",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "backfill:category-tax-maps": "node scripts/backfill-default-category-tax-maps.mjs",
    "backfill:category-tax-maps:dry": "node scripts/backfill-default-category-tax-maps.mjs --dry-run",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:frontend-v3",
    "build:frontend-v3": "node scripts/build-v3-phrase-catalog.mjs && npm --prefix frontend-v3 run build",
    "i18n:v3:check": "node scripts/build-v3-phrase-catalog.mjs --check",
    "test:export-grant": "node scripts/test-export-grant.mjs",
    "test:region-tax": "node scripts/test-region-tax.mjs",
    "test:accounts-put": "node scripts/test-accounts-put.mjs",
    "test:mileage-put": "node scripts/test-mileage-put.mjs",
    "test:email": "node scripts/test-email.mjs",
    "emails:reminders": "node scripts/send-email-reminders.js",
    "migrations:verify-checksums": "node scripts/repair-migration-checksums.js",
    "migrations:repair-checksums": "node scripts/repair-migration-checksums.js --write",
    "verify:redacted-storage": "node scripts/verify-redacted-storage.mjs",
    "security:deps": "npm audit --omit=dev --audit-level=high",
    "log_scan": "node scripts/log_scan.js",
    "i18n:audit": "node scripts/i18n-audit.js",
    "i18n:audit:strict": "node scripts/i18n-audit.js --fail-on-untranslated",
    "i18n:fix": "node scripts/i18n-fix.js",
    "test:csrf": "node --test tests/csrfProtection.test.js",
    "test:csrf-e2e": "node --test tests/csrfE2E.test.js",
    "test:account-deletion": "node --test tests/accountDeletion.test.js",
    "test:health": "node --test tests/healthCheckService.test.js",
    "test:receipt-storage": "node --test tests/receiptStorage.test.js",
    "test:receipts-upload": "node --test tests/receiptUploadValidation.test.js",
    "test:rate-limiter": "node --test tests/rateLimiter.test.js",
    "test:subscription-service": "node --test tests/subscriptionService.test.js",
    "test:accounting-controls": "node --test tests/accountingControls.test.js",
    "test:asvs-controls": "node -e \"require('./tests/asvsControls.test.js')\"",
    "test:auth-flows": "node --test tests/authFlows.test.js",
    "test:sign-in-security": "node --test tests/signInSecurityService.test.js",
    "test:critical-flows": "node --test tests/criticalFlows.test.js",
    "test:harness": "node --test tests/testHarness.test.js",
    "test:integration": "node --test tests/integrationFlows.test.js",
    "test:billing-addon": "node --test tests/billingAddonManagement.test.js",
    "test:e2e": "npx playwright test",
    "test:e2e:smoke": "npx playwright test tests/e2e/v3-pages.spec.js tests/e2e/v3-interactions.spec.js",
    "test:e2e:comprehensive": "npx playwright test tests/e2e/comprehensive.spec.js",
    "test:all": "node scripts/run-all-node-tests.mjs && node -e \"require('./tests/asvsControls.test.js')\"",
    "seed:dev": "node scripts/seed-dev.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "1.4.5-lts.1",
    "pg": "^8.11.5",
    "plaid": "^42.2.0",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.11.0",
    "resend": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  }
}
